APP_NAME="Vendor Handshake"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vob_front_end
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# SESSION_LIFETIME is storage lifetime only; keep >= VOB_SESSION_ABSOLUTE_MINUTES. Sign-out timing is VOB_SESSION_* below.
SESSION_LIFETIME=600
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- Admin Panel API (docs/API_CONTRACT.md). Secrets/keys are created by the owner, never by the code. ---
ADMIN_API_BASE_URL=http://127.0.0.1:8000
ADMIN_API_HMAC_SECRET=
ADMIN_API_RSA_PUBLIC_KEY_PATH=storage/app/public/vob_public.pem
ADMIN_API_RSA_KEY_ID=k1
ADMIN_API_TIMEOUT=15
ADMIN_API_RETRIES=2

# Documents go straight to this private S3 bucket (same bucket as the Admin's TOT_DOCS_DISK=s3)
VOB_DOCS_DISK=s3
VOB_MASTERS_CACHE_MINUTES=10

# Cashfree Reverse Penny Drop (bank verification). Sandbox credentials only work with CASHFREE_ENV=sandbox.
# Whitelist this server's egress IP in the Cashfree dashboard; point the RPD webhook at https://<vob-host>/webhooks/cashfree
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# ignore | reject_no_match
CASHFREE_NAME_MATCH=ignore

# api_logs retention (months) used by logs:purge-api
API_LOG_RETENTION_MONTHS=2

# --- Development switches: false = Submit is not blocked on mandatory fields / documents. Ignored (always on) when APP_ENV=production. ---
VOB_ENFORCE_REQUIRED=true
VOB_ENFORCE_DOCUMENTS=true
VOB_DISPLAY_TIMEZONE=Asia/Kolkata

# Vendor session expiry (minutes): idle = no request for this long; absolute = since sign-in. Admin token limits are 30 / 480.
VOB_SESSION_IDLE_MINUTES=30  //how long a vendor can be inactive.
VOB_SESSION_ABSOLUTE_MINUTES=480  //The maximum time since sign-in, even if active.


# Production: SESSION_SECURE_COOKIE=true, SESSION_DRIVER=redis, CACHE_STORE=redis
